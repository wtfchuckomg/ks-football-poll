rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One document per voter, per week+class. Anyone can read (public
    // standings), anyone can submit/replace/delete a ballot shaped like
    // a real ballot (10 ranked schools). There's no way to verify an
    // emailHash actually belongs to the person submitting it — that
    // matches the site's original design (email is an identity hint,
    // not an authentication check).
    match /polls/{pollId}/entries/{entryId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['rankings', 'ts'])
        && request.resource.data.rankings is list
        && request.resource.data.rankings.size() == 10;
      allow delete: if true;
    }

    // Everyone can read the current week / week list; only a signed-in
    // admin can change it.
    match /meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Everyone can read whether a week's results are released; only a
    // signed-in admin can toggle it.
    match /releases/{week} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Everyone can read team records; only a signed-in admin can edit them.
    match /records/{recId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
